# Copia este archivo a `.env` y ajusta los valores.

# Conexión a la base de datos. El código la lee de aquí: no hay ninguna
# cadena escrita a mano dentro del programa.
DATABASE_URL=sqlite:///./app.db

# Clave con la que se firman las sesiones. CÁMBIALA en producción:
# quien la tenga puede entrar como cualquier usuario.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
